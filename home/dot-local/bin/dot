#!/bin/bash
#
# This runs on the bash that ships with macOS, which is 3.2, because it
# bootstraps a machine before anything newer is installed. So no associative
# arrays, no mapfile, no ${var,,}. The tests always run it with /bin/bash.
set -e

# These three can be overridden from the environment, which is how the tests
# run dot against fixture directories instead of the real home directory.
dotfiles=${DOTFILES:-$HOME/src/github.com/rickharris/dotfiles}
target=${DOT_TARGET:-$HOME}
layers_file=${DOT_LAYERS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/dot/layers}
# How many commits this checkout is behind origin/main, as of the last
# `dot update --check`. The shell prompt reads it. Empty when not known.
cache_file=${XDG_CACHE_HOME:-$HOME/.cache}/dot/behind
# Try to load homebrew in case it has been installed already but the script
# failed and needs to be re-run. This keeps us from re-installing homebrew.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv bash)"
fi

install() {
  # Install hombrew first, which will download also download Command Line Tools
  # for Xcode.
  if ! command -v brew >/dev/null 2>&1; then
    echo -e "\nInstalling Homebrew…"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)"

    if [[ ! -f $HOME/.zprofile ]]; then
      touch "$HOME"/.zprofile
    fi
    # We don't want shellenv to be run
    # shellcheck disable=SC2016
    echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >>"$HOME"/.zprofile
    eval "$(/opt/homebrew/bin/brew shellenv bash)"
    brew completions link
  fi

  # The repo is public and git comes with the Command Line Tools that Homebrew
  # just installed, so cloning needs no auth.
  if [ ! -d "$dotfiles" ]; then
    git clone https://github.com/rickharris/dotfiles.git "$dotfiles"
  fi

  # Everything that needs someone at the keyboard comes first, so the long
  # unattended part of the install can run to the end on its own.

  # Ask once per machine whether it gets the personal layer. The answer is
  # recorded by writing the layers file, so this never asks again.
  if [[ ! -e $layers_file && -t 0 ]]; then
    offer_personal_layer
  fi

  # Install 1Password early so we can access passwords during gh auth login
  if [ ! -d "/Applications/1Password.app" ]; then
    echo -e "\nInstalling 1Password app…"
    brew install --cask 1password
  fi

  if ! command -v op >/dev/null 2>&1; then
    echo -e "\nInstalling 1Password CLI…"
    brew install --cask 1password-cli
  fi

  if ! command -v gh >/dev/null 2>&1; then
    brew install gh
  fi

  # Link before anything below gets a chance to write its own dotfiles. In
  # particular `gh auth login` writes ~/.gitconfig, and a regular file there
  # would block linking ours. link installs stow itself if it is missing.
  link

  # Open 1Password and wait for user to sign in
  setup1p=$(op account list 2>/dev/null || true)
  if [ -z "$setup1p" ]; then
    while [ -z "$setup1p" ]; do
      echo -e "\n1Password needs to be set up before continuing."
      echo "Opening 1Password app..."
      open /Applications/1Password.app || true

      cat <<-EOF

	Please complete the following steps:
	1. Sign in to your 1Password account
	2. Enable the setting "Developer -> Integrate with 1Password CLI"

	Press Enter once you've done those things to continue...
	EOF
      read -r
      setup1p=$(op account list 2>/dev/null || true)
    done
  fi

  if ! gh auth status --hostname github.com >/dev/null; then
    gh auth login --git-protocol=https --hostname=github.com --web
  fi

  # From here on nothing asks for input. Install every layer's Brewfile, the
  # base repo's first.
  layers
  local layer
  for layer in "${layer_dirs[@]}"; do
    if [[ -f $layer/Brewfile ]]; then
      bundle "$layer"/Brewfile
    fi
  done

  # GitHub's CLI for stacked pull requests. gh extensions live outside
  # Homebrew, so the Brewfile cannot cover it.
  if ! gh extension list | grep -q 'github/gh-stack'; then
    echo -e "\nInstalling gh stack…"
    gh extension install github/gh-stack
  fi

  # Migrate claude-code off the Homebrew cask if it was installed that way
  # previously. The cask disables Claude Code's built-in auto-update, so we
  # prefer the native installer going forward.
  if brew list --cask claude-code >/dev/null 2>&1; then
    echo -e "\nRemoving Homebrew-installed claude-code…"
    brew uninstall --cask claude-code
  fi

  if ! command -v claude >/dev/null 2>&1; then
    echo -e "\nInstalling Claude Code…"
    curl -fsSL https://claude.ai/install.sh | bash
  fi

  # On first install, open up Karabiner-Elements so that it can set itself up
  # and ask for the permissions that it need. After that some form of karabiner
  # should be running and this step can be skipped. It comes from the personal
  # layer, so it may not be installed at all.
  if [[ -d /Applications/Karabiner-Elements.app ]] && ! pgrep -qi karabiner; then
    open /Applications/Karabiner-Elements.app
  fi

  mise install
  # This repo has its own mise.toml, with the pinned formatters its checks
  # use. mise only reads a project config once it has been trusted.
  mise trust --quiet "$dotfiles"/mise.toml
  mise --cd "$dotfiles" install
  mise exec -- nvim --headless +q
}

# Asks whether this machine should use the personal layer (layers/personal in
# this repo) and writes the layers file either way.
offer_personal_layer() {
  local answer
  printf '%s' "Install the personal layer (apps and config for personal machines only)? [y/N] "
  read -r answer || true

  mkdir -p "$(dirname "$layers_file")"
  {
    # The backticks are literal text for whoever reads the file.
    # shellcheck disable=SC2016
    echo '# Layers for this machine, one directory per line. Read by `dot`.'
    echo '# Edit by hand to add or remove layers.'
    if [[ $answer == [yY]* ]]; then
      echo "$dotfiles/layers/personal"
    fi
  } >"$layers_file"
}

# Installs what a Brewfile lists, unless it is already satisfied.
bundle() {
  local brewfile=$1 permissions
  if ! brew bundle check --no-upgrade --file="$brewfile" >/dev/null; then
    brew bundle --no-upgrade --file="$brewfile"

    # Fix permissions issue with homebrew and zsh-completions
    # https://formulae.brew.sh/formula/zsh-completions
    permissions=$(stat -f "%SMp %SLp" "$HOMEBREW_PREFIX"/share)
    if [[ $permissions == *w* ]]; then
      chmod go-w "$HOMEBREW_PREFIX"/share
    fi
  fi
}

# Prints a directory's path with every symlink in it resolved.
resolve_dir() {
  (cd "$1" && pwd -P)
}

# Prints an absolute path with its . and .. parts resolved, without touching
# the filesystem, so it also works for a path that does not exist.
normalize_path() {
  local part
  local -a parts kept
  kept=()
  IFS=/ read -r -a parts <<<"$1"
  for part in "${parts[@]}"; do
    case $part in
    '' | .) ;;
    ..)
      if ((${#kept[@]} > 0)); then
        unset "kept[$((${#kept[@]} - 1))]"
      fi
      ;;
    *) kept+=("$part") ;;
    esac
  done
  if ((${#kept[@]} == 0)); then
    echo /
  else
    printf '/%s' "${kept[@]}"
    echo
  fi
}

# Sets layer_dirs to the base repo followed by every directory listed in the
# layers file. A layer has the same layout as this repo: an optional home/
# package (stowed without folding), an optional folded/ package (stowed with
# folding) and an optional Brewfile.
#
# The layers file holds one directory per line. Blank lines and lines starting
# with # are ignored, and a leading ~ expands to $HOME. Paths must be absolute,
# because a relative one would mean something different depending on where dot
# is run from.
#
# A path that is not absolute, or a directory that does not exist, is an
# error, unless --keep-going is given, in which case it is recorded in
# invalid_layers or missing_layers and skipped.
layers() {
  local keep_going=0
  if [[ ${1:-} == --keep-going ]]; then
    keep_going=1
  fi
  if [[ ! -d $dotfiles ]]; then
    echo "dot: dotfiles repo not found: $dotfiles" >&2
    return 1
  fi
  layer_dirs=("$dotfiles")
  missing_layers=()
  invalid_layers=()
  if [[ ! -f $layers_file ]]; then
    return 0
  fi

  local line
  while IFS= read -r line || [[ -n $line ]]; do
    # Trim leading, then trailing, whitespace.
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    if [[ -z $line || $line == \#* ]]; then
      continue
    fi
    # Only ~ and ~/ are expanded. ~name is left alone and then rejected below
    # for not being absolute.
    if [[ $line == \~ || $line == \~/* ]]; then
      line=$HOME${line#\~}
    fi
    if [[ $line != /* ]]; then
      if ((keep_going)); then
        invalid_layers+=("$line")
        continue
      fi
      echo "dot: layer path must be absolute: $line" >&2
      return 1
    fi
    if [[ ! -d $line ]]; then
      if ((keep_going)); then
        missing_layers+=("$line")
        continue
      fi
      echo "dot: layer not found: $line" >&2
      return 1
    fi
    layer_dirs+=("$line")
  done <"$layers_file"
}

# Runs stow for one package of one layer: stow_pkg <layer> <package> <args...>
# Stow refuses the whole package if any target is in the way, so on failure
# say which layer it was and what to do about it.
stow_pkg() {
  local layer=$1 package=$2 output arg unlinking=0
  shift 2
  for arg in "$@"; do
    if [[ $arg == -D ]]; then
      unlinking=1
    fi
  done
  if ! output=$(stow --dir "$layer" --target="$target" --dotfiles "$@" "$package" 2>&1); then
    echo "$output" >&2
    # The backticks in these messages are literal text for the reader.
    # shellcheck disable=SC2016
    if ((unlinking)); then
      echo "dot: could not unlink $layer/$package." >&2
      echo 'dot: move the files listed above out of the way, then re-run `dot unlink`.' >&2
    else
      echo "dot: could not link $layer/$package." >&2
      echo 'dot: move the files listed above out of the way (or merge them into the repo), then re-run `dot link`.' >&2
    fi
    return 1
  fi
}

# Prints every broken symlink in the target that points into a layer, one per
# line. Needs layer_dirs to be set. These are left behind when a directory is
# removed from a layer or moved to another one: stow only cleans up inside
# directories the package still has.
#
# Only the target's top level and the top-level directories that some layer
# still provides (.config, .local, ...) are searched, not all of the target.
# So if a whole top-level directory is removed from every layer, run
# `dot unlink` before removing it.
dangling_links() {
  local layer package entry name root link dest
  local -a resolved_layers roots
  resolved_layers=()
  roots=()

  for layer in "${layer_dirs[@]}"; do
    resolved_layers+=("$(resolve_dir "$layer")")
    for package in home folded; do
      if [[ ! -d $layer/$package ]]; then
        continue
      fi
      while IFS= read -r entry; do
        name=${entry##*/}
        if [[ $name == dot-* ]]; then
          name=.${name#dot-}
        fi
        roots+=("$target/$name")
      done < <(find "$layer/$package" -mindepth 1 -maxdepth 1 -type d)
    done
  done

  # This group is one side of a pipeline, so it runs in a subshell that still
  # has set -e. find exits non-zero when it meets a directory it cannot read,
  # and without the `|| true` that would silently skip every later root.
  {
    find "$target" -maxdepth 1 -type l || true
    for root in "${roots[@]}"; do
      if [[ -d $root && ! -L $root ]]; then
        find "$root" -type l || true
      fi
    done
  } 2>/dev/null | sort -u | while IFS= read -r link; do
    if [[ -e $link ]]; then
      continue
    fi
    # Resolve the link text against the link's own directory, with symlinked
    # parents resolved on both sides so /tmp and /private/tmp compare equal.
    dest=$(readlink "$link")
    if [[ $dest != /* ]]; then
      dest=$(resolve_dir "$(dirname "$link")")/$dest
    fi
    dest=$(normalize_path "$dest")
    for layer in "${resolved_layers[@]}"; do
      if [[ $dest == "$layer"/* ]]; then
        echo "$link"
        break
      fi
    done
  done
}

# Removes the links dangling_links finds, and any directories that leaves
# empty.
prune() {
  local link dir
  dangling_links | while IFS= read -r link; do
    rm -- "$link"
    echo "pruned: $link"
    dir=$(dirname "$link")
    while [[ $dir == "$target"/* ]] && rmdir -- "$dir" 2>/dev/null; do
      dir=$(dirname "$dir")
    done
  done
}

link() {
  if ! command -v stow >/dev/null 2>&1; then
    brew install stow
  fi

  layers
  # The install prompt is the only thing that writes the layers file. A machine
  # that was set up before layers existed has never been asked, and would
  # otherwise lose what moved into the personal layer without a word.
  if [[ ! -e $layers_file && -d $dotfiles/layers/personal ]]; then
    echo "dot: the personal layer is not enabled on this machine, because $layers_file does not exist." >&2
    echo "dot: run \`dot install\` to be asked about it, or see the Layers section of the README." >&2
  fi

  # Prune before stowing: a directory that moved from one layer to another
  # leaves a dangling link that would block stow at the new location.
  prune

  local layer
  for layer in "${layer_dirs[@]}"; do
    if [[ -d $layer/home ]]; then
      stow_pkg "$layer" home --restow --no-folding
    fi
    # The folded package is stowed with folding enabled so its app directories
    # are symlinked whole. This is for apps that save config by writing a new
    # file and renaming it over the old one (e.g. Karabiner-Elements), which
    # would replace a file-level symlink with a regular file.
    if [[ -d $layer/folded ]]; then
      stow_pkg "$layer" folded --restow
    fi
  done
}

unlink() {
  layers
  local layer i
  # Last layer first, the reverse of the order they were linked in.
  for ((i = ${#layer_dirs[@]} - 1; i >= 0; i--)); do
    layer=${layer_dirs[i]}
    if [[ -d $layer/folded ]]; then
      stow_pkg "$layer" folded -D
    fi
    if [[ -d $layer/home ]]; then
      stow_pkg "$layer" home -D --no-folding
    fi
  done
}

# Succeeds when a directory is the top of its own git work tree, which a layer
# kept inside another repo (layers/personal) is not.
is_git_root() {
  local top
  top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 1
  if [[ $top != "$(resolve_dir "$1")" ]]; then
    return 1
  fi
}

# Succeeds when a repo has main checked out. A detached HEAD is not main.
on_main() {
  if [[ $(git -C "$1" symbolic-ref --short -q HEAD) != main ]]; then
    return 1
  fi
}

# Fetches main from origin without printing anything, and without asking for
# credentials, because the prompt runs this in the background.
fetch_origin() {
  GIT_TERMINAL_PROMPT=0 git -C "$1" fetch --quiet origin main >/dev/null 2>&1
}

# Prints how many commits a repo is behind origin/main, going by what was last
# fetched. Fails if there is no origin/main.
behind_count() {
  git -C "$1" rev-list --count HEAD..origin/main 2>/dev/null
}

# Writes a count to the cache file. It is written under another name and moved
# into place, so the prompt never reads half a file. Fails quietly if the
# cache cannot be written.
write_cache() {
  local tmp_file=$cache_file.$$
  {
    mkdir -p "$(dirname "$cache_file")" &&
      echo "$1" >"$tmp_file" &&
      mv -f "$tmp_file" "$cache_file"
  } 2>/dev/null
}

# Says how far behind origin/main this checkout is, and records it in the
# cache file for the prompt. The prompt runs this in the background with the
# output thrown away, so failing to write the cache is never an error.
update_check() {
  # Touch the cache file first. The prompt starts a check when the file is
  # old, so this stops it starting a second one while this one runs, and
  # keeps a failed fetch from being retried on every prompt.
  {
    mkdir -p "$(dirname "$cache_file")" && touch "$cache_file"
  } 2>/dev/null || true

  if ! is_git_root "$dotfiles"; then
    echo "dot: not a git repository: $dotfiles" >&2
    return 1
  fi
  if ! on_main "$dotfiles"; then
    write_cache 0 || true
    echo "dot: not on the main branch, so not checked"
    return 0
  fi

  local count
  if ! fetch_origin "$dotfiles" || ! count=$(behind_count "$dotfiles"); then
    echo "dot: could not fetch from origin" >&2
    return 1
  fi
  write_cache "$count" || true
  if ((count == 0)); then
    echo "dot: up to date with origin/main"
  else
    echo "dot: $count commit(s) behind origin/main; run \`dot update\`"
  fi
}

# Fast-forwards the base repo and every layer that is a git repo of its own.
# This is the half of `dot update` the tests can run.
#
# The base repo has to be on main, so an update never lands on a branch that
# is being worked on. A fast-forward leaves local edits alone and fails if
# they are in the way, or if main has commits origin does not, which is
# better than merging or rebasing without being asked. --no-rebase keeps a
# pull.rebase setting from turning the pull into a rebase.
pull_layers() {
  local i layer
  layers
  if ! is_git_root "$dotfiles"; then
    echo "dot: not a git repository: $dotfiles" >&2
    return 1
  fi
  if ! on_main "$dotfiles"; then
    echo "dot: $dotfiles is not on the main branch; switch to it, then re-run \`dot update\`." >&2
    return 1
  fi
  if ! git -C "$dotfiles" pull --no-rebase --ff-only origin main; then
    echo "dot: could not fast-forward $dotfiles." >&2
    return 1
  fi
  # This repo now matches origin, so clear the count the prompt shows. The
  # count is only about this repo, so do it before the other layers get a
  # chance to fail.
  write_cache 0 || true

  # Other layers are pulled on whatever branch they have checked out. A layer
  # kept inside another repo, like layers/personal, came with that repo. A
  # layer with nothing to pull from (a repo that was never pushed, or a
  # detached HEAD) is left as it is rather than stopping the update.
  for ((i = 1; i < ${#layer_dirs[@]}; i++)); do
    layer=${layer_dirs[i]}
    if ! is_git_root "$layer"; then
      continue
    fi
    if ! git -C "$layer" rev-parse -q --verify '@{upstream}' >/dev/null 2>&1; then
      continue
    fi
    if ! git -C "$layer" pull --no-rebase --ff-only; then
      echo "dot: could not fast-forward $layer." >&2
      return 1
    fi
  done
}

update() {
  pull_layers
  # Start the script again rather than calling install here. bash has already
  # read this copy, and the pull may have changed what install does.
  exec "$dotfiles/home/dot-local/bin/dot" install
}

# Reports drift without changing anything in the home directory: layers that
# are missing, files that are not linked, links that were replaced by regular
# files, dangling links, a checkout that is behind origin/main and unsatisfied
# Brewfiles. The one thing it does change is git's record of origin, because
# it fetches to find out whether the checkout is behind.
doctor() {
  local problems=0 layer package output line behind
  local -a flags

  layers --keep-going
  for layer in "${invalid_layers[@]}"; do
    echo "layer path must be absolute: $layer"
    problems=$((problems + 1))
  done
  for layer in "${missing_layers[@]}"; do
    echo "missing layer: $layer"
    problems=$((problems + 1))
  done

  # Without stow there is no way to tell what is linked, so say that once
  # rather than reporting every package as a conflict.
  local have_stow=1
  if ! command -v stow >/dev/null 2>&1; then
    have_stow=0
    echo "stow is not installed: run \`dot install\`"
    problems=$((problems + 1))
  fi

  for layer in "${layer_dirs[@]}"; do
    for package in home folded; do
      if ((have_stow == 0)) || [[ ! -d $layer/$package ]]; then
        continue
      fi
      flags=()
      if [[ $package == home ]]; then
        flags=(--no-folding)
      fi

      # A dry run without --restow only reports what is not yet in place, and
      # fails if something is in the way, which is how a link that an app
      # replaced with a regular file shows up.
      if ! output=$(stow -n -v --dir "$layer" --target="$target" --dotfiles "${flags[@]}" "$package" 2>&1); then
        echo "conflict in $layer/$package:"
        problems=$((problems + 1))
      fi
      while IFS= read -r line; do
        case $line in
        "  * "*) echo "$line" ;;
        "LINK: "*)
          line=${line#LINK: }
          echo "not linked: $target/${line%% => *}"
          problems=$((problems + 1))
          ;;
        esac
      done <<<"$output"
    done
  done

  while IFS= read -r line; do
    echo "dangling: $line"
    problems=$((problems + 1))
  done < <(dangling_links)

  # A failed fetch is not a problem in itself: offline, compare against what
  # was fetched last. Only main is compared, so a branch being worked on does
  # not count as drift.
  if is_git_root "$dotfiles" && on_main "$dotfiles"; then
    fetch_origin "$dotfiles" || true
    if behind=$(behind_count "$dotfiles") && ((behind > 0)); then
      echo "behind origin/main by $behind commit(s): run \`dot update\`"
      problems=$((problems + 1))
    fi
  fi

  for layer in "${layer_dirs[@]}"; do
    if [[ -f $layer/Brewfile ]] && ! brew bundle check --no-upgrade --file="$layer/Brewfile" >/dev/null 2>&1; then
      echo "brewfile not satisfied: $layer/Brewfile"
      problems=$((problems + 1))
    fi
  done

  if ((problems)); then
    echo "dot: $problems problem(s) found" >&2
    return 1
  fi
  echo "dot: ok"
}

# Setting Safari preferences needs Full Disk Access for the terminal, so this
# write doubles as the check for it.
check_full_disk_access() {
  # Enable Safari Developer Menu
  if ! defaults write com.apple.Safari IncludeDevelopMenu -bool true; then
    cat <<-EOF
Before running this script, enable Full Disk Access for your terminal.

https://support.apple.com/guide/mac-help/change-privacy-security-settings-on-mac-mchl211c911f/mac
EOF
    exit 1
  fi
}

preferences() {
  check_full_disk_access

  # Many things taken from https://mths.be/macos

  # Close any open System Preferences panes, to prevent them from overriding
  # settings we’re about to change
  osascript -e 'tell application "System Preferences" to quit'

  # Trackpad: enable tap to click for this user and for the login screen
  defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true
  defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
  defaults write NSGlobalDomain com.apple.mouse.tapBehavior -int 1

  # Mouse: Increase tracking speed
  defaults write NSGlobalDomain com.apple.mouse.scaling -float "2"

  # Fast key repeat
  defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false
  defaults write NSGlobalDomain KeyRepeat -int 2
  defaults write NSGlobalDomain InitialKeyRepeat -int 15

  # Hide Dock
  defaults write com.apple.dock autohide -bool true

  # No recents in Dock
  defaults write com.apple.dock show-recents -bool false

  if ! defaults read com.rickharris.dotfiles dockConfigured >/dev/null 2>&1; then
    defaults delete com.apple.dock persistent-apps 2>/dev/null || true
    for app in \
      "/System/Applications/Mail.app" \
      "/System/Applications/Calendar.app" \
      "/Applications/Safari.app" \
      "/Applications/Zen.app" \
      "/Applications/Ghostty.app"; do
      # Not every machine has every app, and a missing one leaves a broken
      # tile in the Dock.
      if [[ ! -d $app ]]; then
        continue
      fi
      defaults write com.apple.dock persistent-apps -array-add \
        "<dict><key>tile-data</key><dict><key>file-data</key><dict><key>_CFURLString</key><string>$(resolve_dir "$app")</string><key>_CFURLStringType</key><integer>0</integer></dict></dict></dict>"
    done

    defaults write com.rickharris.dotfiles dockConfigured -bool true
    killall Dock
  fi

  # Finder defaults to column view
  defaults write com.apple.finder "FXPreferredViewStyle" -string "clmv" && killall Finder

  # New Finder windows open home folder
  defaults write com.apple.finder NewWindowTarget -string "PfHm"

  # Ask for location only once per website
  # 0 = deny everything
  # 1 = ask once per day
  # 2 = ask once
  defaults write com.apple.Safari SafariGeolocationPermissionPolicy -int 2

  # Privacy: don’t send search queries to Apple
  defaults write com.apple.Safari UniversalSearchEnabled -bool false
  defaults write com.apple.Safari SuppressSearchSuggestions -bool true

  # Press Tab to highlight each item on a web page
  defaults write com.apple.Safari WebKitTabToLinksPreferenceKey -bool true
  defaults write com.apple.Safari com.apple.Safari.ContentPageGroupIdentifier.WebKit2TabsToLinks -bool true

  # Disable AutoFill
  # defaults write com.apple.Safari AutoFillFromAddressBook -bool false
  defaults write com.apple.Safari AutoFillPasswords -bool false
  defaults write com.apple.Safari AutoFillCreditCardData -bool false
  defaults write com.apple.Safari AutoFillMiscellaneousForms -bool false

  # Show status bar
  defaults write com.apple.Safari ShowStatusBar -bool true
  defaults write com.apple.Safari ShowOverlayStatusBar -bool true
  defaults write com.apple.Safari ShowStatusBarInFullScreen -bool true

  # Enable Web Inspector / developer tools
  defaults write com.apple.Safari WebKitDeveloperExtrasEnabledPreferenceKey -bool true
  defaults write com.apple.Safari com.apple.Safari.ContentPageGroupIdentifier.WebKit2DeveloperExtrasEnabled -bool true

  # Configure DuckDuckGo as main search engine
  defaults write com.apple.Safari SearchProviderIdentifier -string "com.duckduckgo"
  defaults write NSGlobalDomain NSProviderIdentifier -string "com.duckduckgo"

  # Disable video controls showing overlay on top of video when active
  # https://underpassapp.com/news/2025/11/3.html
  defaults write com.apple.Safari InternalDebugHostedBlurMaterialInMediaControlsEnabled -bool false
}

if [ $# -eq 0 ]; then
  # Fail on missing permissions now rather than after a long install.
  check_full_disk_access
  install
  preferences
  exit
fi

print_help() {
  printf "%s\n\n" "Run scripts related to your dotfiles repo."
  printf "%-20s%s\n" "dot" "Run all scripts in the proper order"
  printf "%-20s%s\n" "dot install" "Install dependencies"
  printf "%-20s%s\n" "dot link" "Link dotfiles the correct location"
  printf "%-20s%s\n" "dot unlink" "Remove dotfile symlinks"
  printf "%-20s%s\n" "dot doctor" "Check for drift without changing anything"
  printf "%-20s%s\n" "dot prefs" "Set system and app preferences"
  printf "%-20s%s\n" "dot update" "Pull the latest dotfiles and run install"
  printf "%-20s%s\n" "dot update --check" "Report how far behind origin/main this is"
}

case ${1:-} in
install)
  install
  ;;
link)
  link
  ;;
unlink)
  unlink
  ;;
doctor)
  doctor
  ;;
prefs)
  preferences
  ;;
update)
  case ${2:-} in
  '')
    update
    ;;
  --check)
    update_check
    ;;
  *)
    print_help >&2
    exit 1
    ;;
  esac
  ;;
__pull)
  # Not a public command; it lets the tests run update without the install.
  pull_layers
  ;;
__offer-personal-layer)
  # Not a public command; it lets the tests drive the install prompt.
  offer_personal_layer
  ;;
help | -h | --help)
  print_help
  ;;
*)
  print_help >&2
  exit 1
  ;;
esac
