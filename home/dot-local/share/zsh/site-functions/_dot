#compdef dot

_dot() {
  _arguments -C "1: :->cmds" "*:: :->args"

  case "$state" in
  cmds)
    _values "dot command" \
      "install[Install dependencies]" \
      "link[Link dotfiles the correct location]" \
      "unlink[Remove dotfile symlinks]" \
      "doctor[Check for drift without changing anything]" \
      "prefs[Set system and app preferences]" \
      "update[Pull the latest dotfiles and run install]" \
      "help[Show the list of commands]"
    ;;
  args)
    case $words[1] in
    install)
      _arguments \
        "--layer[Also set up the private layer at this URL]:url:" \
        "--user[The GitHub login the private layer belongs to]:login:"
      ;;
    update)
      _arguments "--check[Report how far behind origin/main this is]"
      ;;
    esac
    ;;
  esac
}
