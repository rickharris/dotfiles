#compdef dot

_dot() {
  _arguments -C "1: :->cmds"

  case "$state" in
  cmds)
    _values "dot command" \
      "install[Install dependencies]" \
      "link[Link dotfiles the correct location]" \
      "unlink[Remove dotfile symlinks]" \
      "doctor[Check for drift without changing anything]" \
      "prefs[Set system and app preferences]" \
      "help[Show the list of commands]"
    ;;
  esac
}
